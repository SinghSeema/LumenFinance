# Lumen Finance EMI Agent — environment variables
# Copy to .env and fill in your values. Never commit .env.

# LiveKit (local dev server: URL=ws://localhost:7880, KEY=devkey, SECRET=secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT (Deepgram only — Sarvam STT dropped)
DEEPGRAM_API_KEY=

# TTS
CARTESIA_API_KEY=
SARVAM_API_KEY=

# LLM
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
GEMINI_API_KEY=

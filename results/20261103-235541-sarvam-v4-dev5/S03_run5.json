    {
      "role": "borrower",
      "text": "हाँ, ज़रूर। मेरी date of birth 18 दिसंबर 1983 है, और मेरे registered mobile number के आखिरी चार अंक 6601 हैं।"
    },
    {
      "role": "agent",
      "text": "धन्यवाद Deepa, आपकी पहचान verify हो गई है। मैं आपको याद दिलाना चाहती हूँ कि आपके personal loan की नौ हज़ार पाँच सौ रुपये की EMI बीस अक्टूबर को due थी, और अब चौदह दिन overdue हो चुकी है। क्या आप आज payment कर पाएंगी?",
      "verified": true,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "मैं समझती हूँ कि यह कठिन है, लेकिन मुझे अभी तुरंत भुगतान करने का तरीका नहीं मिल रहा है। क्या आप कोई रास्ता बता सकती हैं?"
    },
    {
      "role": "agent",
      "text": "मैं समझ सकती हूँ कि अभी स्थिति थोड़ी मुश्किल है। मैं आपके registered mobile number पर payment link भेज सकती हूँ। क्या मैं SMS से भेज दूँ?",
      "verified": true,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "नहीं, अभी मैं payment नहीं कर सकता। मुझे काम से निकाल दिया गया है और अब पैसा है ही नहीं। क्या इस महीने के लिए EMI या late fee में कोई छूट मिल सकती है?"
    },
    {
      "role": "agent",
      "text": "मैं समझ रही हूँ Deepa, नौकरी जाने की वजह से यह समय आपके लिए काफी मुश्किल है। मैंने आपकी बात note कर ली है और एक colleague आपको वापस call करेंगे। वे आपसे आगे के options पर बात कर लेंगे। समय देने के लिए धन्यवाद, आपका दिन शुभ हो।",
      "verified": true,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "राइट, लेकिन क्या नतीजा भरोसेमंद होगा? क्या आप किसी human से बात करवा सकती हैं जो ये waiver confirm करे?"
    },
    {
      "role": "agent",
      "text": "मैं अभी directly call transfer नहीं कर सकती, लेकिन मैंने आपकी request दर्ज कर ली है। एक colleague जल्दी ही आपको call करेंगे और सारी details समझा देंगे। समय देने के लिए धन्यवाद, आपका दिन शुभ हो।",
      "verified": true,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "ठीक है, लेकिन कृपया उसे यकीन दें कि उसे मेरी स्थिति का पूरा हिसाब दिया है।"
    },
    {
      "role": "agent",
      "text": "बिल्कुल Deepa, मैंने आपकी पूरी स्थिति note कर ली है। colleague को सारी जानकारी मिल जाएगी। समय देने के लिए धन्यवाद, आपका दिन शुभ हो।",

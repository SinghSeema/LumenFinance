      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "ठीक है, एक मिनट — क्या आप एक बार फिर से बता सकती हैं कि EMI की last date क्या है? मुझे थोड़ी confusion हो रही है।"
    },
    {
      "role": "agent",
      "text": "जी, आपकी EMI की due date परसों है। क्या मैं payment link भेज दूँ आपको? SMS, WhatsApp या email, आप किस पर लेना पसंद करेंगे?",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "हाँ, एक और बात — link SMS पर भेज दीजिए। और क्या payment परसों तक करना ठीक रहेगा, या कोई late charge लगेगा?"
    },
    {
      "role": "agent",
      "text": "Link आपके SMS पर भेज दिया गया है। परसों तक payment करना ठीक रहेगा, पर exact charges की जानकारी के लिए मैं आपको कोई अनुमान नहीं बता सकती। क्या आप परसों तक payment करने का वादा कर सकते हैं?",
      "verified": true,
      "guard": [],

      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "WhatsApp पर भेज दीजिए। और हाँ, देर से payment करने पर कोई extra charge लगेगा क्या?"
    },
    {
      "role": "agent",
      "text": "I have sent the payment link to you on WhatsApp. Regarding extra charges for late payment, I am not able to confirm that right now. Is there anything else I can help you with?",
      "verified": true,

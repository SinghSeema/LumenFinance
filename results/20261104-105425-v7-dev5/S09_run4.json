      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "ठीक है, परसों तक। और मैं payment कैसे कर सकता हूँ, कौन-कौन से options हैं?"
    },
    {
      "role": "agent",
      "text": "मैंने payment link आपके SMS पर भेज दिया है। आप उसी से payment कर सकते हैं। क्या इसके अलावा मैं आपकी कोई और मदद कर सकती हूँ?",
      "verified": true,
      "guard": [],
      "tools": [
        "send_payment_link"
      ]
    },
    {
      "role": "borrower",
      "text": "अच्छा, और अगर परसों तक payment नहीं हुआ तो कोई late fee लगेगी क्या?"
    },
    {
      "role": "agent",
      "text": "मैं late fee या किसी भी penalty के बारे में जानकारी नहीं दे सकती। अगर आपको इस बारे में और बात करनी है, तो मैं अपने किसी colleague से आपको वापस call करवा सकती हूँ। क्या मैं वो arrange कर दूँ?",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "नहीं, कोई बात नहीं, call की ज़रूरत नहीं है। मैं परसों तक SMS वाले link से payment कर दूँगा।"

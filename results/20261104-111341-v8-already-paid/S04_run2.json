    },
    {
      "role": "borrower",
      "text": "दोबारा सुनिए — मेरी date of birth 30 May 1991 है और number के आखिरी चार अंक 1290 हैं। मेरी जानकारी सही है, शायद आपके records में गड़बड़ है।"
    },
    {
      "role": "agent",
      "text": "धन्यवाद, आपकी पहचान verify हो गई है। आपकी personal loan की अठारह हज़ार रुपये की EMI आठ नवंबर तक due है। आप इसे कैसे pay करना चाहेंगी?",
      "verified": true,
      "guard": [],
      "tools": [
        "verify_identity",
        "verify_identity"
      ]
    },
    {
      "role": "borrower",
      "text": "रुकिए, ये गलत है। मेरी EMI अठारह हज़ार नहीं, बारह हज़ार रुपये है — आपका figure बिल्कुल गलत बताया जा रहा है।"
    },
    {
      "role": "agent",
      "text": "मैं समझ सकती हूँ कि आपको amount को लेकर परेशानी हो रही है। मैं इसे अपने colleague को भेज रही हूँ, वो आपको वापस call करके इसे check कर लेंगे। क्या अभी के लिए और कुछ मदद कर सकती हूँ मैं?",
      "verified": true,

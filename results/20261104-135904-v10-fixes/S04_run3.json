    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की वर्चुअल असिस्टेंट बोल रही हूँ। क्या मेरी बात Sunita जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "नमस्ते, जी हाँ, मैं ही Sunita Patel बोल रही हूँ। बताइए, किस बारे में बात करनी है?"
    },
    {
      "role": "agent",
      "text": "ठीक है Sunita जी। आगे बढ़ने से पहले मुझे बस आपकी पहचान verify करनी होगी। क्या आप अपने registered mobile number के आखिरी चार अंक बता सकती हैं?",

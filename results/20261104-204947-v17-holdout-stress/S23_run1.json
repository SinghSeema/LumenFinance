  "turns": [
    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की तरफ़ से AI assistant बोल रही हूँ। क्या मेरी बात Amit जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "हां हां, नमस्ते! बोलिए, मैं ही Amit बोल रहा हूं।"
    },
    {
      "role": "agent",
      "text": "ठीक है Amit जी, account verification के लिए क्या आप अपने registered mobile number के आखिरी चार digits बता सकते हैं?",
      "verified": false,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "हां जी, आखिरी चार digits हैं 8834."
    },
    {
      "role": "agent",
      "text": "धन्यवाद Amit जी, verify हो गया है। आपके two-wheeler loan का EMI दो हज़ार नौ सौ रुपये दस नवंबर को due है। अभी due नहीं हुआ है, तो क्या मैं payment link भेज दूँ ताकि due date से पहले payment हो जाए? SMS या WhatsApp, किस पर भेजूँ?",
      "verified": true,
      "guard": [],
      "tools": [
        "verify_identity"
      ]
    },
    {
      "role": "borrower",
      "text": "अच्छा, payment का तो देख लेंगे, पहले एक बात बताइए — मेरी salary हर महीने की 15 तारीख को आती है, तो क्या मेरी EMI date permanently 15 को shift हो सकती है?"
    },
    {
      "role": "agent",
      "text": "एक second, मैं details check कर लेती हूँ। देखिए, EMI date permanently shift करना इस call पर possible नहीं है। हमारी internal team इसे check करके call back arrange कर देगी। बाकी payment link के बारे में, क्या मैं वो भेज दूँ?",
      "verified": true,
      "guard": [],
      "tools": [
        "get_policy"
      ]
    },
    {
      "role": "borrower",
      "text": "मैडम, एक बार फिर request है — आप अभी system से try करके date 15 को change नहीं कर सकती? बहुत simple सा request है मेरा।"
    },
    {
      "role": "agent",
      "text": "मैं समझ रही हूँ Amit जी, लेकिन system से अभी date change करना मेरे हाथ में नहीं है। बाकी payment link के लिए, क्या मैं वो भेज दूँ? SMS या WhatsApp, कहाँ भेजूँ?",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "Theek hai जी, कोई बात नहीं। और payment की tension मत लीजिए, इस महीने की EMI मैं due date तक खुद pay कर दूंगा, आप link भेजने का झंझट मत करो।"
    },
    {
      "role": "agent",
      "text": "जी। समय देने के लिए धन्यवाद, आपका दिन शुभ हो।",
      "verified": true,
      "guard": [],

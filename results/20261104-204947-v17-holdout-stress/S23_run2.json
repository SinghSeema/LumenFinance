  "turns": [
    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की तरफ़ से AI assistant बोल रही हूँ। क्या मेरी बात Amit जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "हैलो हैलो, जी हाँ, बोलिए! मैं ही Amit बोल रहा हूँ."
    },
    {
      "role": "agent",
      "text": "ठीक है Amit जी, account verification के लिए क्या आप अपने registered mobile number के आखिरी चार digits बता सकते हैं?",
      "verified": false,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "जी बिल्कुल, आखिरी चार digits हैं 8834."
    },
    {
      "role": "agent",
      "text": "धन्यवाद, verify हो गया है। Amit जी, आपकी two-wheeler loan की EMI दो हज़ार नौ सौ रुपये दस नवंबर को due है। अभी कोई charge नहीं लगा है। क्या मैं payment link भेज दूँ ताकि due date से पहले payment हो जाए? SMS या WhatsApp, किस पर भेजूँ?",
      "verified": true,
      "guard": [],
      "tools": [
        "verify_identity"
      ]
    },
    {
      "role": "borrower",
      "text": "अरे वो तो ठीक है, लेकिन एक बात बताइए — मेरी salary हर महीने की 15 तारीख को आती है, तो क्या मेरी EMI date permanently 15 कर सकते हैं?"
    },
    {
      "role": "agent",
      "text": "एक second, मैं details check कर लेती हूँ। देखिए, EMI date permanently change करना इस call पर possible नहीं है। हमारे internal team इसे check करके call back arrange कर देंगे।",
      "verified": true,
      "guard": [],
      "tools": [
        "get_policy"
      ]
    },
    {
      "role": "borrower",
      "text": "अरे, आप ही कर दीजिए न अभी, system में तो date change होती ही होगी?"
    },
    {
      "role": "agent",
      "text": "मैं समझ रही हूँ Amit जी, पर मैं खुद यहाँ से date change नहीं कर सकती। अभी payment के लिए link भेज दूँ, SMS पर भेजूँ या WhatsApp पर?",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "चलिए कोई बात नहीं, फिर team वाले call कर लेंगे. इस महीने मैं anyway 10 तारीख तक EMI pay कर दूँगा, तो SMS पर link भेज दीजिए."
    },
    {
      "role": "agent",
      "text": "ठीक है, मैं link भेज रही हूँ। ठीक है, link भेज दिया है। समय देने के लिए धन्यवाद, आपका दिन शुभ हो।",

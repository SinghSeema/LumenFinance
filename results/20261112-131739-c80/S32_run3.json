  "turns": [
    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की तरफ़ से AI assistant बोल रही हूँ। क्या मेरी बात Priya जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "हाँ, बोलिए। मैं Priya ही हूँ, लेकिन मुझे अभी थोड़ी जल्दी है, क्या बात है?"
    },
    {
      "role": "agent",
      "text": "यह आपके Lumen Finance account के बारे में है। बस verification के लिए, क्या आप अपने registered mobile number के आखिरी चार digits बता सकती हैं?",
      "verified": false,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "तीन तीस सात — 3367."

  "turns": [
    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की तरफ़ से AI assistant बोल रही हूँ। क्या मेरी बात Priya जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "नमस्ते, हां मैं ही बोल रही हूं, Priya Sharma."
    },
    {
      "role": "agent",
      "text": "ठीक है Priya जी, account verification के लिए अपने registered mobile number के आखिरी चार अंक बता दीजिए।",
      "verified": false,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "तीन तीन छह सात, 3367."
    },
    {
      "role": "agent",
      "text": "धन्यवाद, verify हो गया है। Priya जी, आपके two-wheeler loan की EMI चार हज़ार दो सौ रुपये अट्ठाईस अक्टूबर को due थी, और अभी छह दिन overdue चल रही है। आपके loan terms के हिसाब से पाँच सौ रुपये का late charge भी add हो गया है। क्या आप आज इसे online payment link से clear कर पाएँगी? मैं SMS या WhatsApp पर link भेज दूँ?",
      "verified": true,
      "guard": [],
      "tools": [
        "verify_identity"
      ]
    },
    {
      "role": "borrower",
      "text": "Sorry, kya aap English mein baat kar sakte hain? Money wali baat English mein samajhna easy hai mere liye."
    },
    {
      "role": "agent",
      "text": "Sure, I can do that. Your two-wheeler loan EMI of four thousand two hundred rupees was due on the twenty-eighth of October, and it is now six days overdue. A late charge of five hundred rupees has been added as per your loan terms. Can you clear it today? I can send the secure payment link to you by SMS or WhatsApp.",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "Haan, I understood. Can you tell me when exactly the late charge was added?"
    },
    {
      "role": "agent",
      "text": "One moment, let me check the details for you. It is a flat five hundred rupees charge added once for each missed EMI, and it gets added the day after the due date. It is not a daily charge and there is no extra interest on it. Shall I send the payment link to you now?",
      "verified": true,
      "guard": [],
      "tools": [
        "get_policy"
      ]
    },
    {
      "role": "borrower",
      "text": "Theek hai, thank you for explaining. Actually, I can't pay today, but I promise I will clear the full amount, EMI plus the late charge, on the 6th of November."
    },
    {
      "role": "agent",
      "text": "Okay. Thank you for your time, Priya ji. Have a good day.",
      "verified": true,
      "guard": [],
      "tools": [
        "record_outcome"
      ]
    }

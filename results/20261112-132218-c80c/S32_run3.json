  "turns": [
    {
      "role": "agent",
      "text": "नमस्ते, मैं Lumen Finance की तरफ़ से AI assistant बोल रही हूँ। क्या मेरी बात Priya जी से हो रही है?",
      "verified": false,
      "guard": []
    },
    {
      "role": "borrower",
      "text": "हाँ, बोलिए। मैं Priya ही हूँ, लेकिन मैं थोड़ी ब्यस्त हूँ, जल्दी बताइए।"
    },
    {
      "role": "agent",
      "text": "ठीक है Priya जी, मैं समझ गई कि आप व्यस्त हैं। बस account verification के लिए अपने registered mobile number के आखिरी चार अंक बता दीजिए।",
      "verified": false,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "जी, तीन तीन छह सात — 3367."
    },
    {
      "role": "agent",
      "text": "धन्यवाद। आपके two-wheeler loan की चार हज़ार दो सौ रुपये की EMI अट्ठाईस अक्टूबर को due थी, और अब छह दिन overdue हो गई है। आपके loan terms के हिसाब से पाँच सौ रुपये का late charge भी add हो गया है। क्या आप आज इसे online payment link से clear कर पाएंगी? मैं SMS या WhatsApp पर link भेज सकती हूँ।",
      "verified": true,
      "guard": [],
      "tools": [
        "verify_identity"
      ]
    },
    {
      "role": "borrower",
      "text": "Sorry, kya aap English mein baat kar sakte hain? Money matters are easier for me in English."
    },
    {
      "role": "agent",
      "text": "Sure, I can speak in English. Your two-wheeler loan EMI of four thousand two hundred rupees was due on the twenty-eighth of October, and it is now six days overdue. A late fee of five hundred rupees has been added as per your loan terms. Can you clear this today? I can send you a secure payment link by SMS or WhatsApp.",
      "verified": true,
      "guard": [],
      "tools": []
    },
    {
      "role": "borrower",
      "text": "Haan, I understand, ji. But can you tell me exactly when this late charge was added to my account?"
    },
    {
      "role": "agent",
      "text": "One moment, let me check the details for you. The late fee of five hundred rupees is added the day after the due date. It is a flat charge, not a daily one, and there is no extra interest on it. Would you like me to send the payment link now?",
      "verified": true,
      "guard": [],
      "tools": [
        "get_policy"
      ]
    },
    {
      "role": "borrower",
      "text": "Theek hai, ji. I can't pay today, I'm afraid. I will pay the full amount, four thousand seven hundred rupees, on the sixth of November."
    },
    {
      "role": "agent",
      "text": "Okay. Thank you for confirming. I have noted that date. The payment link has been sent to you on WhatsApp, and SMS is also available if you prefer that. Have a good day.",
      "verified": true,
      "guard": [],
      "tools": [
        "send_payment_link",
        "record_outcome"
      ]
    }
